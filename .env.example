# Local dev / Vercel
# Pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Direct connection (used by prisma migrate during build).
# For poolers like Neon/Supabase pgbouncer, set this to the non-pooled URL.
# If not using a pooler, you can leave this equal to DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
